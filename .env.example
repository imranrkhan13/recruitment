# Postgres connection string (Neon free tier works). Without it the app
# stores data in a local aria-data.json file.
DATABASE_URL=

# Bolna Voice AI credentials (only used when real calls are enabled)
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_uuid_here

# Real outbound calls ring real phones and spend Bolna credits.
# They stay OFF until you set this to true - without it every call
# is a local demo with sample results.
ALLOW_REAL_CALLS=false

# Required for the screening webhook: the endpoint is disabled while
# unset, then only accepts posts with this as the x-webhook-token header.
WEBHOOK_TOKEN=

# Required for first-run owner setup: the setup screen asks for this
# private code so a stranger who finds the URL first cannot claim the
# workspace. Setup stays closed while unset.
BOOTSTRAP_SECRET=

PORT=3001
COMPANY_NAME=Aria AI

# Optional: where to store app data when not using Postgres
# DATA_FILE=./aria-data.json
